{
  "cleanupPeriodDays": 3650,
  "env": {
    "GUSTO_CLAUDE_SETUP": "true",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(/Users/john.lee/workspace/eng_ai_assistant/scripts/prune-session-worktrees.sh *)",
      "Bash(/Users/john.lee/workspace/eng_ai_assistant/scripts/prune-submodule-worktrees.sh *)",
      "Bash(bats *)",
      "Bash(bin/rspec *)",
      "Bash(bin/rubocop *)",
      "Bash(bin/srb *)",
      "Bash(bktide *)",
      "Bash(bundle exec rspec *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo test *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jj *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mise ls *)",
      "Bash(mise ls-remote *)",
      "Bash(mkdir *)",
      "Bash(ruby -c *)",
      "Bash(scripts/prune-session-worktrees.sh *)",
      "Bash(scripts/prune-submodule-worktrees.sh *)",
      "Bash(tail *)",
      "Bash(tmux *)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "disabledMcpjsonServers": [
    "figma"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if [ \"${CLAUDE_CODE_SESSION_ATTENDED:-1}\" = \"0\" ]; then exit 0; fi; if printf '%s' \"$input\" | grep -q '\"agent_type\"'; then exit 0; fi; if [ -f /tmp/claude-poll-silent ]; then rm -f /tmp/claude-poll-silent; exit 0; fi; afplay -v 0.1 /System/Library/Sounds/Glass.aiff",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/runlayer/aiwatch/aiwatch-hook hook --client claude_code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/runlayer/aiwatch/aiwatch-hook hook --client claude_code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/runlayer/aiwatch/aiwatch-hook hook --client claude_code"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@latest --style=powerline"
  },
  "enabledPlugins": {
    "gusto-essentials@gusto-claude-code": true,
    "gusto-dev@gusto-claude-code": true,
    "gusto-frontend@gusto-claude-code": true,
    "gusto-backend@gusto-claude-code": true,
    "gusto-product@gusto-claude-code": true,
    "superpowers@claude-plugins-official": true,
    "gusto-eng-pes@gusto-claude-code": true,
    "fakechat@claude-plugins-official": false,
    "devloop@gusto-gists": false
  },
  "extraKnownMarketplaces": {
    "gusto-gists": {
      "source": {
        "source": "github",
        "repo": "gusto/gists"
      }
    }
  },
  "outputStyle": "Scannable",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": "auto"
    }
  },
  "autoCompactWindow": 200000,
  "advisorModel": "opus",
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false
}
